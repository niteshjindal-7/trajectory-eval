# =============================================================
# TRAJECTORY EVAL POC — Environment Variables Template
# Copy this file to .env and fill in your actual values
# NEVER commit .env to Git
# =============================================================

# --- LLM Provider Switch ---
LLM_PROVIDER=openai                       # "openai" or "gemini"

# --- Google Gemini ---
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_TASK_MODEL=gemini-3.1-flash-lite
GEMINI_EVAL_MODEL=gemini-3.1-flash-lite

# --- OpenAI ---
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_TASK_MODEL=gpt-4o-mini
OPENAI_EVAL_MODEL=gpt-4o

# --- LangFuse (Observability) ---
LANGFUSE_PUBLIC_KEY=your_langfuse_public_key_here
LANGFUSE_SECRET_KEY=your_langfuse_secret_key_here
LANGFUSE_HOST=https://cloud.langfuse.com

# --- OpenFDA (Optional — increases rate limit) ---
OPENFDA_API_KEY=

# --- Experiment Settings ---
EXPERIMENT_NAME=exp_001_evaluator_v1
MAX_STEPS=10
TASK_FILE=tasks/openfda/healthcare_tasks.json
