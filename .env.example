# =============================================================
# TRAJECTORY EVAL POC — Environment Variables Template
# Copy this file to .env and fill in your actual values
# NEVER commit .env to Git
# =============================================================

# --- Google Gemini (Task Agent + Evaluator) ---
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_TASK_MODEL=gemini-2.5-flash        # Task agent (cheaper, faster)
GEMINI_EVAL_MODEL=gemini-2.5-pro          # Evaluator (more capable)

# --- LangFuse (Observability) ---
LANGFUSE_PUBLIC_KEY=your_langfuse_public_key_here
LANGFUSE_SECRET_KEY=your_langfuse_secret_key_here
LANGFUSE_HOST=https://cloud.langfuse.com  # Change if self-hosting on EC2

# --- OpenFDA (Optional — increases rate limit from 240 to 1000 req/min) ---
OPENFDA_API_KEY=                          # Leave blank to start; add later if needed

# --- Experiment Settings ---
EXPERIMENT_NAME=exp_001_evaluator_v1
MAX_STEPS=10                              # Max tool calls per agent run
TASK_FILE=tasks/openfda/healthcare_tasks.json
